### 변수 설정
@hostname = localhost
@port = 8085
@baseUrl = http://{{hostname}}:{{port}}/api/rule
@roomId = 1
@flowId = 3
@scheduleId = 2
@userId = 1
@userRole = ADMIN

### [플로우 스케줄 생성]
POST {{baseUrl}}/rooms/{{roomId}}/flows/{{flowId}}/schedules
X-User-Id: {{userId}}
X-User-Role: {{userRole}}
Content-Type: application/json
Accept: application/json

{
  "dayOfWeek": "MONDAY",
  "startTime": "19:00:30",
  "endTime": "20:00:00"
}

> {%
    client.test("플로우 스케줄 생성 응답은 201 Created", function() {
        client.assert(response.status === 201, "Response status is not 201");
    });
    client.test("생성 응답에 scheduleId가 포함됨", function() {
        client.assert(response.body.scheduleId !== undefined, "scheduleId is missing");
    });
%}

### [특정 플로우의 스케줄 목록 조회]
GET {{baseUrl}}/rooms/{{roomId}}/flows/{{flowId}}/schedules
X-User-Id: {{userId}}
X-User-Role: {{userRole}}
Accept: application/json

> {%
    client.test("스케줄 목록 조회 응답은 200 OK", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### [특정 플로우의 특정 스케줄 단건 조회]
GET {{baseUrl}}/rooms/{{roomId}}/flows/{{flowId}}/schedules/{{scheduleId}}
X-User-Id: {{userId}}
X-User-Role: {{userRole}}
Accept: application/json

> {%
    client.test("스케줄 상세 조회 응답은 200 OK", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### [플로우 스케줄 삭제]
DELETE {{baseUrl}}/rooms/{{roomId}}/flows/{{flowId}}/schedules/{{scheduleId}}
X-User-Id: {{userId}}
X-User-Role: {{userRole}}

> {%
    client.test("플로우 스케줄 삭제 응답은 204 No Content", function() {
        client.assert(response.status === 204, "Response status is not 204");
    });
%}
