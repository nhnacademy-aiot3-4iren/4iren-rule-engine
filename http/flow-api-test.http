### 변수 설정
@hostname = localhost
@port = 8085
@baseUrl = http://{{hostname}}:{{port}}/api/rule
@roomId = 1
@flowId = 1
@templateId = 2
@userId = 1
@userRole = ADMIN


### [플로우 빌드 폼 호출]
GET {{baseUrl}}/rooms/{{roomId}}/flows/form
X-User-Id: {{userId}}
X-User-Role: {{userRole}}
Accept: application/json

> {%
    client.test("플로우 빌드 폼 조회 응답은 200 OK", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### [플로우 생성] START -> THRESHOLD -> ALERT
POST {{baseUrl}}/rooms/{{roomId}}/flows
X-User-Id: {{userId}}
X-User-Role: {{userRole}}
Content-Type: application/json
Accept: application/json

{
  "flowName": "강의실 101호 쾌적도 제어 플로우",
  "description": "CO2 농도가 높을 때 텔레그램으로 환기 알림을 보내는 플로우",
  "isActive": true,
  "nodes": [
    {
      "nodeId": -1,
      "nodeName": "시작",
      "nodeType": "START",
      "nodeConfig": {
        "nodeType": "START",
        "x": 0,
        "y": 150
      }
    },
    {
      "nodeId": -2,
      "nodeName": "이산화탄소 임계치 판단 노드",
      "nodeType": "THRESHOLD",
      "nodeConfig": {
        "nodeType": "THRESHOLD",
        "x": 160,
        "y": 150,
        "measurementType": "CO2",
        "unit": "ppm",
        "operator": "GT",
        "threshold": 1000.0
      }
    },
    {
      "nodeId": -3,
      "nodeName": "텔레그램 경고 알림 노드",
      "nodeType": "ALERT",
      "nodeConfig": {
        "nodeType": "ALERT",
        "x": 320,
        "y": 150,
        "channel": "TELEGRAM",
        "alertTitle": "실내 이산화탄소 수치 초과",
        "alertType": "COMFORT_LIMIT_EXCEEDED",
        "dedupWindowSec": 300
      }
    }
  ],
  "connections": [
    {
      "sourceNodeId": -1,
      "targetNodeId": -2,
      "branchType": "TRUE"
    },
    {
      "sourceNodeId": -2,
      "targetNodeId": -3,
      "branchType": "TRUE"
    }
  ]
}

> {%
    client.test("플로우 생성 응답은 201 Created", function() {
        client.assert(response.status === 201, "Response status is not 201");
    });
    client.test("생성 응답에 flowId가 포함됨", function() {
        client.assert(response.body.flowId !== undefined, "flowId is missing");
    });
%}

