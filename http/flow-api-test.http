@baseUrl = http://localhost:8080
@roomId = 101
@flowId = 1
@templateId = 1
@contentType = application/json

###1. 플로우 목록 조회
GET {{baseUrl}}/api/rooms/{{roomId}}/flows
Accept: {{contentType}}

### 2. 플로우 상세 조회
GET {{baseUrl}}/api/rooms/{{roomId}}/flows/{{flowId}}
Accept: {{contentType}}

### 3. 강의실 별 템플릿 플로우 제안 목록 조회
GET {{baseUrl}}/api/rooms/{{roomId}}/flows/templates
Accept: {{contentType}}

### 4. 템플릿 플로우 상세 조회
GET {{baseUrl}}/api/rooms/{{roomId}}/flows/templates/{{templateId}}
Accept: {{contentType}}

### 5. 플로우 생성 - THRESHOLD + ALERT 예시
POST {{baseUrl}}/api/rooms/{{roomId}}/flows
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "flowName": "CO2 임계치 알림 플로우",
  "description": "CO2가 기준치 이상이면 텔레그램 알림 전송",
  "isActive": true,
  "schedules": [
    {
      "dayOfWeek": "MONDAY",
      "startTime": "09:00:00",
      "endTime": "18:00:00"
    },
    {
      "dayOfWeek": "TUESDAY",
      "startTime": "09:00:00",
      "endTime": "18:00:00"
    }
  ],
  "nodes": [
    {
      "tempNodeId": -1,
      "nodeName": "CO2 임계치 조건",
      "nodeType": "THRESHOLD",
      "cooldownSec": 60,
      "nodeConfig": {
        "nodeType": "THRESHOLD",
        "sensorType": "CO2",
        "operator": "GTE",
        "threshold": 1000,
        "unit": "PPM",
        "validDurationSec": 60,
        "x": 120,
        "y": 180
      }
    },
    {
      "tempNodeId": -2,
      "nodeName": "텔레그램 알림",
      "nodeType": "ALERT",
      "cooldownSec": 300,
      "nodeConfig": {
        "nodeType": "ALERT",
        "channel": "TELEGRAM",
        "chatId": "123456789",
        "messageTemplate": "[경고] CO2 농도가 높습니다.",
        "dedupWindowSec": 300,
        "x": 420,
        "y": 180
      }
    }
  ],
  "connections": [
    {
      "sourceNodeId": -1,
      "targetNodeId": -2,
      "conditionResult": "TRUE"
    }
  ]
}


