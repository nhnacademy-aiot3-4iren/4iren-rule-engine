### 변수 설정
@hostname = localhost
@port = 8085
@baseUrl = http://{{hostname}}:{{port}}/api/rule
@roomId = 1
@flowId = 1

### [플로우 생성] 새로운 플로우 등록 (음수 임시 ID 포함)
POST {{baseUrl}}/rooms/{{roomId}}/flows
X-User-Id: 1
X-User-Role: ADMIN
Content-Type: application/json

{
  "flowName": "강의실 101호 쾌적도 제어 플로우",
  "description": "CO2 농도가 높을 때 텔레그램으로 환기 알림을 보내는 플로우",
  "isActive": true,
  "nodes": [
    {
      "nodeId": -1,
      "nodeName": "시작",
      "nodeType": "START",
      "nodeConfig": {
        "nodeType": "START",
        "x": 0,
        "y": 150
      }
    },
    {
      "nodeId": -2,
      "nodeName": "이산화탄소 임계치 판단 노드",
      "nodeType": "THRESHOLD",
      "nodeConfig": {
        "nodeType": "THRESHOLD",
        "x": 100,
        "y": 150,
        "measurementType": "CO2",
        "unit": "ppm",
        "operator": "GT",
        "threshold": 1000.0
      }
    },
    {
      "nodeId": -3,
      "nodeName": "텔레그램 경고 알림 노드",
      "nodeType": "ALERT",
      "nodeConfig": {
        "nodeType": "ALERT",
        "x": 300,
        "y": 150,
        "channel": "TELEGRAM",
        "alertTitle": "실내 이산화탄소 수치 초과!",
        "alertType": "COMFORT_LIMIT_EXCEEDED",
        "dedupWindowSec":300
      }
    }
  ],
  "connections": [
    {
      "sourceNodeId": -1,
      "targetNodeId": -2,
      "branchType": "TRUE"
    },
    {
      "sourceNodeId": -2,
      "targetNodeId": -3,
      "branchType": "TRUE"
    }
  ]
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 201, "Response status is not 201");
    });
%}

### [플로우 목록 조회] 해당 룸의 전체 플로우 조회
GET {{baseUrl}}/rooms/{{roomId}}/flows
Accept: application/json

### [강의실별 템플릿 플로우 제안 목록 조회]
GET {{baseUrl}}/rooms/{{roomId}}/flows/templates
Accept: application/json

### [플로우 단건 상세 조회 및 수정 폼]
GET {{baseUrl}}/rooms/{{roomId}}/flows/{{flowId}}
Accept: application/json

### [추천 템플릿 플로우 상세 조회] (충돌 방지 경로 적용)
GET {{baseUrl}}/rooms/{{roomId}}/flows/templates/1
Accept: application/json

### [플로우 수정] 기존 플로우 정보 및 노드 구조 대치
PUT {{baseUrl}}/rooms/{{roomId}}/flows/{{flowId}}
Content-Type: application/json

{
  "flowName": "강의실 101호 쾌적도 제어 플로우 (수정)",
  "description": "평균 온도 감지 기능이 추가된 플로우",
  "isActive": true,
  "nodes": [
    {
      "nodeId": 1,
      "nodeName": "온도 평균값 판단 노드",
      "nodeType": "AVERAGE",
      "nodeConfig": {
        "nodeType": "AVERAGE",
        "x": 120,
        "y": 200,
        "measurementType": "TEMPERATURE",
        "unit": "°C",
        "operator": "GTE",
        "average": 28.5,
        "windowSec": 600
      }
    },
    {
      "nodeId": -2,
      "nodeName": "텔레그램 경고 알림 노드",
      "nodeType": "ALERT",
      "nodeConfig": {
        "nodeType": "ALERT",
        "x": 300,
        "y": 150,
        "channel": "TELEGRAM",
        "alertTitle": "실내 이산화탄소 수치 초과!",
        "alertType": "COMFORT_LIMIT_EXCEEDED"
      }
    }
  ],
  "connections": [
      {
      "sourceNodeId": 1,
      "targetNodeId": -2
      }
  ]
}

### [플로우 삭제]
DELETE {{baseUrl}}/rooms/{{roomId}}/flows/{{flowId}}

### [플로우 활성화/비활성화 설정]
PATCH {{baseUrl}}/rooms/{{roomId}}/flows/{{flowId}}/active
Content-Type: application/json

{
  "isActive": true
}

### [플로우 빌드 폼 호출] 강의실 기준 센서 메타 정보 보냄
GET {{baseUrl}}/rooms/{{roomId}}/flows/form
Accept: application/json