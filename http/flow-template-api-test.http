### 변수 설정
@hostname = localhost
@port = 8085
@baseUrl = http://{{hostname}}:{{port}}/api/rule/templates
@templateId = 2

### [템플릿 플로우 생성] START -> GRADIENT -> ALERT
POST {{baseUrl}}
Content-Type: application/json
Accept: application/json

{
  "flowName": "표준 환기 권장 템플릿",
  "description": "모든 강의실에 범용적으로 적용 가능한 기본 대기질 판단 스펙",
  "nodes": [
    {
      "nodeId": -1,
      "nodeName": "시작",
      "nodeType": "START",
      "nodeConfig": {
        "nodeType": "START",
        "x": 0,
        "y": 100
      }
    },
    {
      "nodeId": -2,
      "nodeName": "TVOC 기울기 판단 노드",
      "nodeType": "GRADIENT",
      "nodeConfig": {
        "nodeType": "GRADIENT",
        "x": 160,
        "y": 100,
        "measurementType": "TVOC",
        "unit": "ppb",
        "operator": "GT",
        "gradient": 5.0,
        "windowSec": 300
      }
    },
    {
      "nodeId": -3,
      "nodeName": "텔레그램 경고 알림 노드",
      "nodeType": "ALERT",
      "nodeConfig": {
        "nodeType": "ALERT",
        "x": 320,
        "y": 100,
        "channel": "TELEGRAM",
        "alertTitle": "실내 TVOC 증가 추세 감지",
        "alertType": "VENTILATION_RECOMMEND",
        "dedupWindowSec": 300
      }
    }
  ],
  "connections": [
    {
      "sourceNodeId": -1,
      "targetNodeId": -2,
      "branchType": "TRUE"
    },
    {
      "sourceNodeId": -2,
      "targetNodeId": -3,
      "branchType": "TRUE"
    }
  ]
}

> {%
    client.test("템플릿 플로우 생성 응답은 201 Created", function() {
        client.assert(response.status === 201, "Response status is not 201");
    });
    client.test("생성 응답에 templateFlowId가 포함됨", function() {
        client.assert(response.body.templateFlowId !== undefined, "templateFlowId is missing");
    });
%}

### [템플릿 플로우 목록 조회]
GET {{baseUrl}}
Accept: application/json

> {%
    client.test("템플릿 플로우 목록 조회 응답은 200 OK", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### [템플릿 플로우 상세 조회]
GET {{baseUrl}}/{{templateId}}
Accept: application/json

> {%
    client.test("템플릿 플로우 상세 조회 응답은 200 OK", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### [템플릿 플로우 수정] START -> DURATION -> ALERT
PUT {{baseUrl}}/{{templateId}}
Content-Type: application/json

{
  "flowName": "표준 환기 권장 템플릿 수정",
  "description": "습도 지속시간 판단 조건으로 교체된 템플릿",
  "nodes": [
    {
      "nodeId": -1,
      "nodeName": "시작",
      "nodeType": "START",
      "nodeConfig": {
        "nodeType": "START",
        "x": 0,
        "y": 150
      }
    },
    {
      "nodeId": -2,
      "nodeName": "습도 지속시간 판단 노드",
      "nodeType": "DURATION",
      "nodeConfig": {
        "nodeType": "DURATION",
        "x": 160,
        "y": 150,
        "measurementType": "HUMIDITY",
        "unit": "%",
        "operator": "LTE",
        "threshold": 30.0,
        "durationSec": 1800
      }
    },
    {
      "nodeId": -3,
      "nodeName": "텔레그램 경고 알림 노드",
      "nodeType": "ALERT",
      "nodeConfig": {
        "nodeType": "ALERT",
        "x": 320,
        "y": 150,
        "channel": "TELEGRAM",
        "alertTitle": "실내 습도 장시간 낮음",
        "alertType": "COMFORT_LIMIT_EXCEEDED",
        "dedupWindowSec": 600
      }
    }
  ],
  "connections": [
    {
      "sourceNodeId": -1,
      "targetNodeId": -2,
      "branchType": "TRUE"
    },
    {
      "sourceNodeId": -2,
      "targetNodeId": -3,
      "branchType": "TRUE"
    }
  ]
}

> {%
    client.test("템플릿 플로우 수정 응답은 204 No Content", function() {
        client.assert(response.status === 204, "Response status is not 204");
    });
%}

### [템플릿 플로우 삭제]
DELETE {{baseUrl}}/{{templateId}}

> {%
    client.test("템플릿 플로우 삭제 응답은 204 No Content", function() {
        client.assert(response.status === 204, "Response status is not 204");
    });
%}
